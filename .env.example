# =============================================================================
# OweMe — environment variables
#
# Copy to `.env.local` for local development and add the same keys to your
# Vercel project (Settings → Environment Variables) for production.
# Nothing in here is committed — .env*.local is gitignored.
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Supabase dashboard → Project Settings → API
#   NEXT_PUBLIC_SUPABASE_URL       = "Project URL"                e.g. https://abcdefgh.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  = "Project API keys → anon public"
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Supabase dashboard → Project Settings → API → "service_role secret".
# Used ONLY by admin server actions and the archival Edge Function, which check
# the caller's admin claim before touching anything. Never expose it to the
# browser (it bypasses row level security by design).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google OAuth (Supabase Auth provider) ------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
#   Authorised redirect URI:  https://<your-project-ref>.supabase.co/auth/v1/callback
# The Client ID/secret are pasted into Supabase (Authentication → Providers →
# Google), NOT into this app. They are listed here because Supabase needs them
# and you will be asked for them during setup. Leave them blank if you have
# already configured the provider in the dashboard.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- App ----------------------------------------------------------------------
# Canonical origin, used for OAuth redirects and metadata. No trailing slash.
# Local: http://localhost:3001   Production: https://oweme.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- Phase 2 (optional) -------------------------------------------------------
# Secret expected by the archive-records Edge Function / cron caller. Generate
# with: openssl rand -hex 32
ARCHIVE_CRON_SECRET=

# --- Web Push (VAPID) ---------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BPOpgPYF76-7lewd64cjFS4EgilF25AuySicAiXS_Jz9KObOCGJw9zNjKLYWmyxKW6DqRVrQhqZw6j8JtndJ5ZA
VAPID_PRIVATE_KEY=nSjZYT0BAGb9sKSNnD9Ig1eDIJLSEAUkGEjOeqBhj48
VAPID_SUBJECT=mailto:support@oweme.in

# --- Local database tests (optional) -----------------------------------------
# Only used by `npm run db:verify` against a throwaway database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/oweme_test

